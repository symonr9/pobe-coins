{
  "name": "pobe-coins",
  "private": true,
  "version": "0.1.0",
  "description": "Earn pobe coins by doing chores, spend them at Chubbybara's POBE Shop.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "dev:web": "npm run web -w @pobe/mobile",
    "deploy:dev": "node scripts/deploy/ship.mjs --stage dev",
    "deploy:prod": "node scripts/deploy/ship.mjs --stage prod",
    "dev:api": "tsx packages/functions/src/dev/server.ts",
    "dev:demo": "SEED=1 tsx packages/functions/src/dev/server.ts",
    "e2e": "node apps/mobile/e2e/smoke.mjs",
    "screens": "node apps/mobile/e2e/screens.mjs",
    "deploy:check": "node scripts/deploy/check.mjs",
    "deploy:secrets": "node scripts/deploy/secrets.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "deploy:setup-ci": "node scripts/deploy/setup-ci.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "sst": "^4.17.1",
    "tsx": "^4.23.15"
  }
}
